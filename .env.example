# Required to create a research task once the V1 runtime is wired; blank is missing.
DEEPSEEK_API_KEY=
# Optional for public GitHub repository research.
GITHUB_TOKEN=
DATABASE_URL=sqlite+aiosqlite:///./data/adaptive_agent.db
# Independent P-01 API/Worker only. Use the isolated PostgreSQL app database.
# Example shape: postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5433/DATABASE
P01_DATABASE_URL=
MAX_CONCURRENT_TASKS=2
MAX_STEPS=30
RECENT_TRACE_COUNT=5
DEEPSEEK_MODEL=deepseek-flash
